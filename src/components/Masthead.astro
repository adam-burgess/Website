---
// Main navigation, top right. Highlights the section you're in.
const links = [
  { href: '/',        label: 'Home' },
  { href: '/notes/',  label: 'Field Notes' },
  { href: '/off-the-bench/', label: 'Off the Bench' },
];

const path = Astro.url.pathname;
// Every path starts with '/', so Home only counts as current on the homepage itself.
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="masthead">
  <div class="wrap">
    <nav aria-label="Main">
      {links.map(({ href, label }) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Styles in an .astro file are scoped: they only affect this component. */
  .wrap {
    display: flex; justify-content: flex-end;
    padding-block: 26px 0;
  }
  nav { display: flex; gap: 22px; flex-wrap: wrap; }
  nav a {
    font-size: 14px; color: var(--ink-2); text-decoration: none;
    padding-bottom: 2px; border-bottom: 1px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
</style>
