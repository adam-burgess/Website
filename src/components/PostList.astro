---
// The list of posts on a section page (/notes/, /off-the-bench/).
// Each row: small cover picture · title, series, tags, description · date.
import { Image } from 'astro:assets';
import { postUrl, shortDate, type Post } from '../posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">Nothing here yet.</p>
) : (
  <ul>
    {posts.map((post) => {
      const { title, description, date, tags, series, part, cover, coverAlt, draft } = post.data;
      return (
        <li>
          <a href={postUrl(post)}>
            {/* Thumbnail: the post's cover, or a plain tile so rows still line up. */}
            <span class="thumb">
              {cover && <Image src={cover} alt={coverAlt} width={240} />}
            </span>
            <span class="text">
              <span class="t">{title}{draft && <span class="draft"> (draft)</span>}</span>
              {series && <span class="meta series">Series · {series}{part && ` · Part ${part}`}</span>}
              {tags.length > 0 && <span class="meta tags">{tags.join(' · ')}</span>}
              <span class="d">{description}</span>
            </span>
            <time datetime={date.toISOString()}>{shortDate(date)}</time>
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  li { border-bottom: 1px solid var(--hairline); }
  a {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
    padding: 18px 0;
    color: var(--ink); text-decoration: none;
  }

  /* Small 2:1 picture, the same shape as the home-page cards, centred in its row. */
  .thumb {
    display: block;
    aspect-ratio: 2 / 1;
    align-self: center;   /* sit in the middle of the row, whatever its height */
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .t { font-family: var(--serif); font-size: 21px; line-height: 1.3; }
  a:hover .t { color: var(--accent); }

  /* Small labels, each on its own line: the series (teal), then the tags (grey). */
  .meta {
    font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.09em; text-transform: uppercase;
  }
  .series { color: var(--accent); }
  .tags { color: var(--ink-3); }

  .d { font-size: 15px; color: var(--ink-2); }
  time {
    font-family: var(--mono); font-size: 11px; color: var(--ink-3);
    white-space: nowrap; margin-top: 6px;
  }
  .draft { color: var(--accent); font-size: 0.7em; }
  .empty { color: var(--ink-2); }

  /* Phones: no picture, just the text, with the date underneath. */
  @media (max-width: 560px) {
    a { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .thumb { display: none; }
    time { margin-top: 0; }
  }
</style>
