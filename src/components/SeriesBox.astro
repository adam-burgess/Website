---
// Shown on a post that belongs to a series: "Part 2 of 4 · <series name>",
// then every part as a numbered list with the current one highlighted.
import { postUrl, type Post } from '../posts';

interface Props {
  post: Post;
  parts: Post[];
}

const { post, parts } = Astro.props;
const index = parts.findIndex((p) => p.id === post.id);
---
<nav class="series" aria-label={`Series: ${post.data.series}`}>
  <p class="label">Part {index + 1} of {parts.length} · <span>{post.data.series}</span></p>
  <ol>
    {parts.map((p, i) => (
      <li>
        {i === index
          ? <span aria-current="page">{p.data.title}</span>
          : <a href={postUrl(p)}>{p.data.title}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .series {
    max-width: var(--measure);
    margin: 28px auto 0;
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--ground) 94%, var(--ink));
    border-radius: 0 6px 6px 0;
  }
  .label {
    margin: 0 0 8px;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent);
  }
  .label span { color: var(--ink-2); }
  ol { margin: 0; padding-left: 1.4em; font-size: 15px; line-height: 1.5; }
  li { margin-block: 4px; }
  li::marker { font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
  a { color: var(--ink-2); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  [aria-current] { font-weight: 600; color: var(--ink); }
</style>
