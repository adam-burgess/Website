---
// Off the Bench section page. URL: /off-the-bench/
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, SECTIONS } from '../../lib/posts';

const section = SECTIONS.bench;
const posts = await getPosts('bench');
---
<Base title={section.name} description="Books I’m reading, opinion pieces, and the systems I use to get things done.">
  <section class="wrap">
    <p class="eyebrow">Everything else</p>
    <h1>{section.name}</h1>
    <p class="intro">Books I’m reading, opinion pieces, and the systems I use to get things done.</p>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .wrap { padding-block: 54px 0; max-width: 840px; }
  h1 { margin: 10px 0 10px; font-family: var(--sans); font-weight: 600; font-size: 34px; line-height: 1.1; }
  .intro { margin: 0 0 34px; max-width: 56ch; font-size: 17px; color: var(--ink-2); }
</style>
