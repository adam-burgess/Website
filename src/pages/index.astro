---
// Homepage. Every file in src/pages/ becomes a URL:
//   src/pages/index.astro  ->  /
// Ported from the approved prototype (v3).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAllPosts, postUrl, SECTIONS } from '../lib/posts';

// "Currently" rows. Edit these as things change.
const currently = [
  { label: 'Research', text: 'Honours project at the Curtin Institute of Radio Astronomy — a wirelessly tuneable load for characterising 2.45 GHz antenna arrays.' },
  { label: 'Next',     text: 'Exchange semester at Università di Bologna, early 2027.' },
  { label: 'Reading',  text: 'Ippolito, <em>Satellite Communications Systems Engineering</em> — slowly.' },
];

// Recent writing: the newest posts from both sections, as a sideways-scrolling row
// of cards (modelled on hkk.fyi's Lab). Filled automatically from src/content/.
// A post's `cover` picture shows at the top of its card.
const recent = (await getAllPosts()).slice(0, 6).map((post) => ({
  title: post.data.title,
  tags: [SECTIONS[post.collection].single, ...post.data.tags].join(' · '),
  text: post.data.description,
  href: postUrl(post),
  cover: post.data.cover,
  coverAlt: post.data.coverAlt,
  label: SECTIONS[post.collection].single,
}));

// The doors at the bottom of the page.
const doors = [
  { eyebrow: 'Engineering', title: 'Field Notes', href: '/notes/',  text: 'Write-ups, guides and browser instruments from the bench — measurement, RF hardware, and the parts that went wrong first.' },
  { eyebrow: 'Everything else', title: 'Off the Bench', href: '/off-the-bench/', text: 'Books I’m reading, opinion pieces, and the systems I use to get things done.' },
];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>Hi! I'm Adam <em>Jumari</em> Burgess.</h1>
        <p class="intro">
          Engineering student in Perth, currently building radio hardware for a research
          group that points antennas at the sky. Before that I spent a year in oil and gas
          safety engineering, which taught me more about writing clearly than any unit did.
        </p>
        <p class="intro">
          I demonstrate first-year laboratories, run rural volunteer trips, and keep an
          unreasonable number of notes. This is where the better ones end up.
        </p>
      </div>
      <!-- Swap for <img src="/portrait.jpg" alt="…" /> once the photo is in public/ -->
      <figure class="portrait">
        <span>PORTRAIT</span>
        <span>4:5</span>
      </figure>
    </div>
  </section>

  <section class="currently">
    <div class="wrap">
      <h2 class="eyebrow">Currently</h2>
      <dl>
        {currently.map(({ label, text }) => (
          <>
            <dt>{label}</dt>
            <dd set:html={text} />
          </>
        ))}
      </dl>
    </div>
  </section>

  <section class="recent">
    <div class="wrap">
      <h2 class="section-head">
        Recent writing
        <span class="secrule" aria-hidden="true"></span>
      </h2>
      <div class="bar">
        <p class="section-intro">The latest from Field Notes and Off the Bench. Scroll sideways for more.</p>
        <div class="arrows">
          <button type="button" class="arrow" data-dir="-1" aria-label="Previous">←</button>
          <button type="button" class="arrow" data-dir="1" aria-label="Next">→</button>
        </div>
      </div>

      <!-- The track scrolls sideways; each card snaps into place. -->
      <div class="track" tabindex="0" aria-label="Recent writing">
        {recent.map(({ title, tags, text, href, cover, coverAlt, label }) => (
          <article class="card">
            <a class="preview" href={href} tabindex="-1" aria-hidden="true">
              {cover
                ? <Image src={cover} alt={coverAlt} width={800} />
                : <span class="placeholder">{label}</span>}
            </a>
            <div class="info">
              <h3>{title}</h3>
              <p class="tags">{tags}</p>
              <p class="text">{text}</p>
              <div class="btn-row">
                <a class="btn solid" href={href}>Read →</a>
              </div>
            </div>
          </article>
        ))}
        <article class="card slot">
          <p class="tags">Next up</p>
          <p class="text">On the bench. The next piece goes here.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="doors">
    <div class="wrap">
      {doors.map(({ eyebrow, title, href, text }) => (
        <article class="door">
          <div class="rule"></div>
          <p class="tags">{eyebrow}</p>
          <h2><a href={href}>{title} →</a></h2>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  // Arrow buttons scroll the Recent writing track by one card, and grey out at either end.
  const track = document.querySelector<HTMLElement>('.recent .track');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.recent .arrow');
  if (track) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('.card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      arrows.forEach((b) => {
        b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 0 : track.scrollLeft >= max;
      });
    };
    arrows.forEach((b) =>
      b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step() })),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: 40px 56px;
    align-items: start;
    padding-block: 54px 12px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(36px, 5.6vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  h1 em { color: var(--accent); }
  .intro {
    margin: 0 0 16px;
    max-width: 54ch;
    font-family: var(--serif);
    font-size: 18.5px;
    line-height: 1.6;
  }
  .intro:last-of-type { color: var(--ink-2); font-size: 17px; }

  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    border: 1px dashed var(--hairline);
    background: var(--surface);
    display: grid;
    place-content: center;
    gap: 4px;
    text-align: center;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  /* Section labels are h2s for document structure but look like eyebrows. */
  h2.eyebrow { margin: 0; font-weight: 400; }

  /* ---------- Currently ---------- */
  .currently .wrap { padding-block: 34px 44px; }
  dl {
    margin: 14px 0 0;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    border-top: 1px solid var(--hairline);
  }
  dt {
    padding: 13px 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1.9;
  }
  dd {
    margin: 0;
    padding: 13px 0;
    border-bottom: 1px solid var(--hairline);
  }

  /* ---------- Recent writing (after hkk.fyi's Lab) ---------- */
  .recent { border-top: 1px solid var(--hairline); }
  .recent .wrap { padding-block: 48px 56px; }

  /* Heading, then a rule running to the right edge. */
  .section-head {
    display: flex; align-items: center; gap: 12px;
    margin: 0;
    font-family: var(--sans); font-weight: 600; font-size: 30px; line-height: 1.1;
  }
  .secrule { flex: 1; height: 1.5px; background: color-mix(in srgb, var(--ink) 30%, transparent); }

  .bar {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 16px; margin-top: 26px;
  }
  .section-intro { margin: 0; max-width: 56ch; font-size: 17px; line-height: 1.65; color: var(--ink-2); }
  .arrows { display: flex; gap: 8px; flex: none; }
  .arrow {
    width: 38px; height: 38px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 4px;
    background: var(--surface); color: var(--ink);
    font: 16px var(--mono); cursor: pointer;
  }
  .arrow:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .arrow:disabled { opacity: 0.35; cursor: default; }

  /* Two cards visible at a time; the rest sit off to the right. */
  .track {
    --gap: 20px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--gap)) / 2);
    gap: var(--gap);
    margin-top: 24px;
    padding-bottom: 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline-offset: 6px; }

  .card {
    scroll-snap-align: start;
    display: flex; flex-direction: column;
    /* A shade darker than the page, like hkk's cards. */
    background: color-mix(in srgb, var(--ground) 94%, var(--ink));
    border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .card:hover { border-color: var(--accent); }

  .preview {
    position: relative;
    aspect-ratio: 2 / 1;
    border-bottom: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
    background: var(--surface);
    display: grid; place-content: center;
    text-decoration: none;
  }
  .preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .placeholder { font-family: var(--mono); font-size: 11px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--ink-3); }

  .info { display: flex; flex-direction: column; flex: 1; padding: 22px 20px 20px; }
  .info h3 { margin: 0 0 6px; font-family: var(--sans); font-weight: 600; font-size: 18.5px; line-height: 1.3; }
  .tags {
    margin: 0 0 14px;
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent);
  }
  .text { margin: 0 0 24px; font-size: 16px; line-height: 1.6; }

  .btn-row { margin-top: auto; display: flex; gap: 10px; flex-wrap: wrap; }
  .btn {
    padding: 8px 16px;
    border: 1.5px solid var(--ink); border-radius: 3px;
    font-family: var(--mono); font-size: 13px;
    color: var(--ink); text-decoration: none;
  }
  .btn.solid { background: var(--accent); border-color: var(--accent); color: var(--surface); }
  .btn:hover { filter: brightness(1.1); }

  /* Reserved slot: dashed outline, no preview. */
  .slot { justify-content: center; padding: 24px; border-style: dashed; background: transparent; }
  .slot .text { margin: 0; color: var(--ink-2); }

  /* ---------- Doors ---------- */
  .doors { border-top: 1px solid var(--hairline); }
  .doors .wrap {
    display: grid;
    /* Two equal columns spanning the full width. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 40px;
    padding-block: 44px 52px;
  }
  /* Open layout (no box); label and title borrow the Recent writing styles. */
  .door .rule { height: 2px; width: 30px; background: var(--accent); margin-bottom: 14px; }
  .door .tags { margin: 0 0 8px; }
  .door h2 {
    margin: 0 0 8px;
    font-family: var(--sans); font-weight: 600; font-size: 22px; line-height: 1.25;
  }
  .door h2 a { color: inherit; text-decoration: none; }
  .door h2 a:hover { color: var(--accent); }
  .door p:last-child { margin: 0; font-size: 15px; color: var(--ink-2); }

  /* ---------- Narrow screens: stack everything ---------- */
  @media (max-width: 880px) {
    .hero .wrap { grid-template-columns: 1fr; gap: 30px; padding-block: 38px 8px; }
    .portrait { max-width: 260px; }
    .doors .wrap { grid-template-columns: 1fr; gap: 30px; }
    dl { grid-template-columns: 1fr; }
    dt { padding-bottom: 0; border-bottom: none; }
    dd { padding-top: 4px; }
    /* One card at a time, with a peek of the next so it's obvious you can swipe. */
    .track { grid-auto-columns: 85%; }
    .section-intro { font-size: 16px; }
  }
</style>
