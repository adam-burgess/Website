---
// A section's page: /notes/ and /off-the-bench/.
// One file makes both pages. The square brackets in the folder name, [section],
// mean "fill this in from the list below" — so Astro builds it once per section.
import Base from '../../components/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, SECTION_LIST } from '../../posts';

export function getStaticPaths() {
  return SECTION_LIST.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
const posts = await getPosts(section.key);
---
<Base title={section.name} description={section.blurb}>
  <section class="wrap">
    <p class="eyebrow">{section.eyebrow}</p>
    <h1>{section.name}</h1>
    <p class="intro">{section.blurb}</p>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .wrap { padding-block: 54px 0; max-width: 840px; }
  h1 { margin: 10px 0 10px; font-family: var(--sans); font-weight: 600; font-size: 34px; line-height: 1.1; }
  .intro { margin: 0 0 34px; max-width: 56ch; font-size: 17px; color: var(--ink-2); }
</style>
