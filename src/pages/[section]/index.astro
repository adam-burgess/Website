---
// Field Notes section page. URL: /notes/
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, SECTIONS } from '../../lib/posts';

const section = SECTIONS.notes;
const posts = await getPosts('notes');
---
<Base title={section.name} description="Write-ups, guides and browser instruments from the bench — measurement, RF hardware, and the parts that went wrong first.">
  <section class="wrap">
    <p class="eyebrow">Engineering</p>
    <h1>{section.name}</h1>
    <p class="intro">Write-ups, guides and browser instruments from the bench — measurement, RF hardware, and the parts that went wrong first.</p>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .wrap { padding-block: 54px 0; max-width: 840px; }
  h1 { margin: 10px 0 10px; font-family: var(--sans); font-weight: 600; font-size: 34px; line-height: 1.1; }
  .intro { margin: 0 0 34px; max-width: 56ch; font-size: 17px; color: var(--ink-2); }
</style>
