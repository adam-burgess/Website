---
// The page every post sits in. Off the Bench pieces get a Substack-style reading
// column; Field Notes share it but let figures and code run a little wider.
import Base from './Base.astro';
import SeriesBox from '../components/SeriesBox.astro';
import { SECTIONS, getSeries, longDate, postUrl, readingTime, type Post } from '../lib/posts';
import 'katex/dist/katex.min.css';
import '../styles/piece.css';
import '../styles/prose.css';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const section = SECTIONS[post.collection];

// Series: the other parts, and the ones either side of this post.
const parts = await getSeries(post);
const here = parts.findIndex((p) => p.id === post.id && p.collection === post.collection);
const prev = here > 0 ? parts[here - 1] : undefined;
const next = here >= 0 && here < parts.length - 1 ? parts[here + 1] : undefined;
---
<Base title={title} description={description}>
  <article class:list={['piece', post.collection]}>
    <header>
      <p class="eyebrow">
        <a href={section.path}>{section.name}</a>
        {tags.length > 0 && <span> · {tags.join(' · ')}</span>}
        {draft && <span class="draft"> · Draft</span>}
      </p>
      <h1>{title}</h1>
      <p class="subtitle">{description}</p>
      <p class="byline">
        <span>Adam Jumari Burgess</span>
        <time datetime={date.toISOString()}>{longDate(date)}</time>
        <span>{readingTime(post.body)}</span>
        {updated && <span>Updated {longDate(updated)}</span>}
      </p>
      {parts.length > 1 && <SeriesBox post={post} parts={parts} />}
    </header>

    <div class="prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="series-nav" aria-label="More in this series">
        {prev && <a class="prev" href={postUrl(prev)}><span>← Previous</span>{prev.data.title}</a>}
        {next && <a class="next" href={postUrl(next)}><span>Next →</span>{next.data.title}</a>}
      </nav>
    )}

    <footer class="back">
      <a href={section.path}>← All {section.name}</a>
    </footer>
  </article>
</Base>
